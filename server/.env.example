# ═══════════════════════════════════════════════════════════════════════════════
#  Envelock server configuration — EXAMPLE (committed; never put real secrets here)
# ═══════════════════════════════════════════════════════════════════════════════
#  Every key the application reads, grouped by concern, in the order a
#  deployment fills them in. All keys are ENVELOCK_-prefixed; unset keys fall
#  back to the safe defaults shown here. An unset optional provider disables
#  its feature visibly — nothing breaks silently.
#
#  Companion doc: docs/LAUNCH-GUIDE.md — building the server, where to get each
#  key, and every step still left to launch.
#  Copy to .env and fill in: cp .env.example .env
#


# ─── Core application ───────────────────────────────────────────────────────────
# The runtime identity of this process. `production` arms the boot-time safety
# gates (secret required, RLS opt-out explicit, no reset flag); `development`
# relaxes them for a laptop.
#
# FOCUS_CORE=false is the launch setting. True was the two-feature v1: it
# unmounted the staff/admin console routers AND silently overrode
# CT_WATCHER_ENABLED, so the free Guard tier advertised lookalike monitoring it
# was not doing, and admin.envelock.org had no API to talk to despite being in
# CORS_ORIGINS. (The SIEM drain and the billing/governance routers are no longer
# gated on this at all — see main.py.)
ENVELOCK_ENV=development
ENVELOCK_LOG_LEVEL=INFO
ENVELOCK_API_HOST=0.0.0.0
ENVELOCK_API_PORT=8010
ENVELOCK_TRUST_FORWARDED_FOR=false
ENVELOCK_FOCUS_CORE=false

# ─── Secrets & signing ──────────────────────────────────────────────────────────
# SECRET_KEY signs every session token, webhook token and protected-mail stamp.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Production and staging refuse to boot without it. WEBHOOK_SHARED_SECRET is an
# optional separate key for provider push callbacks (falls back to SECRET_KEY).
ENVELOCK_SECRET_KEY=
ENVELOCK_WEBHOOK_SHARED_SECRET=

# ─── Credential key custody ─────────────────────────────────────────────────────
# How stored mailbox passwords are sealed. `auto` picks from what is set:
# local (MASTER_KEY, dev only) | x25519 (PUBLIC on the API, PRIVATE on the
# worker — the API then cannot decrypt) | aws/gcp KMS. Generate a pair with:
# python -m envelock.security.keygen. NEVER rotate without migrating first
# (python -m envelock.security.rotate_credentials --migrate) or every
# connected mailbox bricks.
ENVELOCK_CREDENTIAL_KEY_PROVIDER=auto
ENVELOCK_CREDENTIAL_MASTER_KEY=
ENVELOCK_CREDENTIAL_PUBLIC_KEY=
ENVELOCK_CREDENTIAL_PRIVATE_KEY=
ENVELOCK_CREDENTIAL_CAN_DECRYPT=true
# aws | gcp — uncomment only when using a cloud KMS custody provider.
# ENVELOCK_KMS_PROVIDER=aws
ENVELOCK_KMS_KEY_ID=
ENVELOCK_KMS_REGION=
# Set ONLY while running `python -m envelock.security.rotate_credentials`
# (the previous master key during a migrate-then-rotate). Remove after.
# ENVELOCK_OLD_CREDENTIAL_MASTER_KEY=

# ─── Datastores ─────────────────────────────────────────────────────────────────
# PostgreSQL is the only supported database. Redis backs the rate limiter,
# lockout, TOTP-replay and token-revocation stores across replicas
# (RATE_LIMIT_BACKEND=redis); a single instance is safe on `memory`.
# ClickHouse/Kafka are for telemetry at scale — unused until configured.
ENVELOCK_POSTGRES_DSN=postgresql+asyncpg://envelock:envelock@localhost:5432/envelock
ENVELOCK_DB_NULLPOOL=false
ENVELOCK_REDIS_DSN=redis://localhost:6379/0
ENVELOCK_RATE_LIMIT_BACKEND=memory
ENVELOCK_CLICKHOUSE_DSN=clickhouse://envelock:envelock@localhost:8123/envelock
ENVELOCK_KAFKA_BOOTSTRAP=localhost:19092
ENVELOCK_KAFKA_TOPIC_EVENTS=envelock.events

# ─── Public URLs & CORS ─────────────────────────────────────────────────────────
# WEB_BASE_URL builds the links inside outgoing email (reset/verify) — a wrong
# value silently emails customers links to a host that is not yours.
# PUBLIC_BASE_URL is where Stripe Checkout returns the buyer. REDIRECT_BASE_URL
# is where rewritten links in protected mail point (must be reachable from a
# phone on mobile data). All three must be YOUR hosts in production.
ENVELOCK_WEB_BASE_URL=https://app.envelock.org
ENVELOCK_PUBLIC_BASE_URL=https://app.envelock.org
ENVELOCK_REDIRECT_BASE_URL=https://api.envelock.org
ENVELOCK_CORS_ORIGINS=https://app.envelock.org,https://admin.envelock.org

# ─── Account policy ─────────────────────────────────────────────────────────────
# REQUIRE_EMAIL_VERIFICATION is the anti-squatting control, and it is ON.
# Without it anyone can register a fake address on a company's domain, claim its
# tenant and burn its one trial. With it on, the trial and the permanent
# one-per-domain claim both start at VERIFICATION rather than at registration,
# so an unverified squatter holds nothing. It needs a working SMTP relay: with
# no relay configured, nobody can complete a signup.
# REQUIRE_DOMAIN_VERIFICATION gates connecting live mail on DNS proof.
ENVELOCK_REQUIRE_EMAIL_VERIFICATION=true
ENVELOCK_REQUIRE_DOMAIN_VERIFICATION=true
ENVELOCK_CHECK_EMAIL_DOMAIN_EXISTS=true
ENVELOCK_DOMAIN_REVERIFY_SECONDS=3600

# ─── Tier 1 — OAuth mail (Microsoft Graph / Gmail) ──────────────────────────────
# App registrations for one-click mailbox connect. Unset = the provider shows
# as not configured; IMAP still works. GOOGLE_PUBSUB_TOPIC enables real-time
# Gmail push and must be the FULL topic name
# (projects/<project-id>/topics/<name>), with gmail-api-push@system.gserviceaccount.com
# granted Publisher on it — polling covers Gmail without it.
ENVELOCK_MS_CLIENT_ID=
ENVELOCK_MS_CLIENT_SECRET=
ENVELOCK_MS_REDIRECT_URI=https://api.envelock.org/api/v1/connect/oauth/microsoft/callback
ENVELOCK_MS_WEBHOOK_URL=https://api.envelock.org/api/v1/webhooks/graph
ENVELOCK_GOOGLE_CLIENT_ID=
ENVELOCK_GOOGLE_CLIENT_SECRET=
ENVELOCK_GOOGLE_REDIRECT_URI=https://api.envelock.org/api/v1/connect/oauth/google/callback
ENVELOCK_GOOGLE_PUBSUB_TOPIC=
ENVELOCK_OAUTH_REFRESH_SECONDS=1800

# ─── Tier 3 — IMAP acquisition ──────────────────────────────────────────────────
# The workhorse for ISP mailboxes: the poll worker fetches, analyses,
# quarantines and rewrites. Defaults are production-sane; the ALLOW_* flags
# loosen safety for self-hosted mail servers only.
ENVELOCK_IMAP_POLL_WORKER_ENABLED=true
ENVELOCK_IMAP_POLL_WORKER_SECONDS=60
ENVELOCK_IMAP_IDLE_ENABLED=true
ENVELOCK_IMAP_IDLE_REFRESH_SECONDS=1500
ENVELOCK_IMAP_MONITORED_POLL_SECONDS=900
ENVELOCK_IMAP_MAX_CONNECTIONS_PER_EGRESS_IP=15
ENVELOCK_IMAP_RECONNECT_JITTER_SECONDS=120
ENVELOCK_IMAP_EGRESS_IPS=
ENVELOCK_IMAP_ALLOW_PRIVATE_HOSTS=false
ENVELOCK_IMAP_ALLOW_PLAINTEXT=false
ENVELOCK_IMAP_EXTRA_ALLOWED_PORTS=
ENVELOCK_IMAP_PROBE_TIMEOUT_SECONDS=8.0
ENVELOCK_IMAP_PROBE_MAX_CANDIDATES=8

# ─── Tier 4 — forwarding ingest ─────────────────────────────────────────────────
# Mail forwarded to <token>@INGEST_DOMAIN. The per-tenant token proves which
# tenant a copy is for; ALLOWED_IPS proves who may forward. Production refuses
# the in-app listener with an empty allowlist.
ENVELOCK_INGEST_DOMAIN=in.envelock.org
ENVELOCK_INGEST_SMTP_HOST=0.0.0.0
ENVELOCK_INGEST_SMTP_PORT=2525
ENVELOCK_INGEST_SMTP_IN_APP=false
ENVELOCK_INGEST_ALLOWED_IPS=

# ─── Link safety (feature 1) ────────────────────────────────────────────────────
# Every URL in protected inbound mail is rewritten to /r/<token> and re-checked
# live at click time. URLhaus is free and on by default; a Google Safe Browsing
# key (free) adds the strongest feed. BANNER_ENABLED is the flag-in-place
# fallback when quarantine fails.
ENVELOCK_LINK_REWRITE_ENABLED=true
ENVELOCK_BANNER_ENABLED=true
ENVELOCK_URLHAUS_ENABLED=true
ENVELOCK_SAFEBROWSING_API_KEY=
ENVELOCK_URL_CHECK_MAX_PER_MESSAGE=5

# ─── Domain & sender intelligence ───────────────────────────────────────────────
# Free-first cascade: CT-log lookalike watching, RDAP registration dates,
# Spamhaus/SURBL DNSBL sender reputation. IPinfo (free tier) adds geo for
# login-anomaly detections; IPQS is optional paid IP intel.
ENVELOCK_CT_WATCHER_ENABLED=true
ENVELOCK_CERTSTREAM_URL=wss://certstream.calidog.io/
ENVELOCK_WATCHER_DOMAIN_REFRESH_SECONDS=300
ENVELOCK_RDAP_BOOTSTRAP_URL=https://rdap.org/
ENVELOCK_SCAN_REGISTRATION_DATES=true
ENVELOCK_DOMAIN_REPUTATION_ENABLED=true
ENVELOCK_DNSBL_DOMAIN_ZONES=dbl.spamhaus.org,multi.surbl.org
ENVELOCK_REPUTATION_CACHE_SECONDS=3600
ENVELOCK_CZDS_USERNAME=
ENVELOCK_CZDS_PASSWORD=
ENVELOCK_NRD_FEED_API_KEY=
ENVELOCK_IPINFO_TOKEN=
ENVELOCK_IPQS_API_KEY=

# ─── Attachment analysis ────────────────────────────────────────────────────────
# ClamAV + YARA run locally and free. Detonation (sandboxing) and VirusTotal
# are paid, off by default, and metered per mailbox when on.
ENVELOCK_CLAMAV_HOST=localhost
ENVELOCK_CLAMAV_PORT=3310
ENVELOCK_YARA_RULES_PATH=./rules/yara
ENVELOCK_ATTACHMENT_CACHE_TTL_CLEAN_DAYS=14
ENVELOCK_DETONATION_ENABLED=false
ENVELOCK_DETONATION_PROVIDER=
ENVELOCK_DETONATION_MONTHLY_CAP_PER_MAILBOX=150
ENVELOCK_VIRUSTOTAL_API_KEY=

# ─── AI cascade — the last-rung LLM judge ───────────────────────────────────────
# Only the ambiguous payment/impersonation band (MEDIUM/HIGH with an A-signal)
# reaches the judge, capped per mailbox per month — never every message.
# A confident fraud verdict promotes one tier and autoflags the alert; it
# never lowers a rule tier. PROVIDER: none | openai | anthropic | local.
ENVELOCK_LLM_PROVIDER=none
ENVELOCK_LLM_MAX_CALLS_PER_MAILBOX_MONTH=200
ENVELOCK_LLM_MIN_CONFIDENCE=0.75
ENVELOCK_LLM_TIMEOUT_SECONDS=20.0
ENVELOCK_OPENAI_API_KEY=
ENVELOCK_OPENAI_MODEL=gpt-4o-mini
ENVELOCK_OPENAI_BASE_URL=https://api.openai.com/v1
ENVELOCK_ANTHROPIC_API_KEY=
ENVELOCK_ANTHROPIC_MODEL=claude-haiku-4-5
ENVELOCK_ANTHROPIC_BASE_URL=https://api.anthropic.com
ENVELOCK_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
ENVELOCK_LOCAL_LLM_MODEL=llama3.1
ENVELOCK_LOCAL_LLM_API_KEY=

# ─── Outbound email (alert rung L2, resets, verification) ───────────────────────
# `localhost` counts as UNCONFIGURED (password reset then reports honestly that
# nothing was sent). DKIM signs with the key at DKIM_PRIVATE_KEY_PATH under
# selector `<DKIM_SELECTOR>._domainkey.<from-domain>`. RELAY_FALLBACK_DSN
# (smtp[s]://user:pass@host:port) carries Critical alerts if the primary dies.
ENVELOCK_SMTP_HOST=
ENVELOCK_SMTP_PORT=587
ENVELOCK_SMTP_USERNAME=
ENVELOCK_SMTP_PASSWORD=
ENVELOCK_SMTP_FROM=alerts@envelock.org
ENVELOCK_SMTP_DKIM_SELECTOR=envelock
ENVELOCK_SMTP_DKIM_PRIVATE_KEY_PATH=
ENVELOCK_SMTP_RELAY_FALLBACK_DSN=

# ─── Push (L1), SMS (L3) & escalation ───────────────────────────────────────────
# Web Push is free and self-hosted via VAPID — generate a P-256 pair once and
# use the SAME pair on every deployment (subscriptions are bound to the public
# key). SMS is the only metered rung; it fires on escalation only.
ENVELOCK_VAPID_PUBLIC_KEY=
ENVELOCK_VAPID_PRIVATE_KEY=
ENVELOCK_VAPID_SUBJECT=mailto:security@envelock.org
ENVELOCK_SMS_ENABLED=false
ENVELOCK_SMS_PROVIDER=
ENVELOCK_SMS_API_KEY=
ENVELOCK_SMS_API_URL=
ENVELOCK_SMS_ACCOUNT_SID=
ENVELOCK_SMS_SENDER_ID=Envelock
ENVELOCK_ESCALATE_CRITICAL_AFTER_SECONDS=900
ENVELOCK_ESCALATE_UNACKED_COUNT=5

# ─── Billing & trials ───────────────────────────────────────────────────────────
# The trial starts at signup on the top plan (at email verification when that
# is on) and falls back to Guard when it lapses — never a lockout. One trial
# per registrable domain, forever. Stripe is the primary rail; the others are
# regional alternatives, each optional.
ENVELOCK_TRIAL_DAYS=15
ENVELOCK_TRIAL_BACKFILL_DAYS=30
ENVELOCK_BACKFILL_DAYS=90
ENVELOCK_BACKFILL_MAX_MESSAGES=5000
ENVELOCK_STRIPE_SECRET_KEY=
ENVELOCK_STRIPE_WEBHOOK_SECRET=
ENVELOCK_STRIPE_PRICE_ESSENTIAL=
ENVELOCK_STRIPE_PRICE_COMPLETE=
ENVELOCK_ADYEN_API_KEY=
ENVELOCK_ADYEN_MERCHANT_ACCOUNT=
ENVELOCK_MERCADOPAGO_ACCESS_TOKEN=
ENVELOCK_RAZORPAY_KEY_ID=
ENVELOCK_RAZORPAY_KEY_SECRET=
ENVELOCK_PAYPAL_CLIENT_ID=
ENVELOCK_PAYPAL_CLIENT_SECRET=

# ─── Tenant isolation (Postgres RLS) & egress ───────────────────────────────────
# The database backstop for tenant isolation. Adoption is three steps, in
# order: provision (python -m envelock.security.provision_rls, needs
# DB_OWNER_DSN), switch POSTGRES_DSN to the DB_APP_ROLE, then RLS_ENABLED=true.
# Production refuses RLS off unless ALLOW_RLS_DISABLED=true is set knowingly.
# WEBHOOK_ALLOW_PRIVATE_HOSTS lets tenant SIEM webhooks resolve to private
# addresses — SSRF shape, self-hosted deployments only.
ENVELOCK_RLS_ENABLED=false
ENVELOCK_ALLOW_RLS_DISABLED=false
# Escape hatch for the production boot gate on REQUIRE_EMAIL_VERIFICATION.
# Leaving this false is correct: setting it true accepts that anyone can claim
# any company's domain on this deployment.
ENVELOCK_ALLOW_UNVERIFIED_SIGNUPS=false
ENVELOCK_DB_APP_ROLE=envelock_app
ENVELOCK_DB_OWNER_DSN=
# Read by `alembic upgrade head` from the SHELL environment (export it),
# not from this file: gates whether the RLS migrations ENABLE/FORCE
# policies. Leave false until the app connects as DB_APP_ROLE.
ENVELOCK_APPLY_RLS=false
ENVELOCK_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# ─── Scheduler & background jobs ────────────────────────────────────────────────
# One scheduler (leader-elected across replicas) runs escalation, retention
# purge, OAuth refresh, domain re-verification and SIEM webhook delivery.
ENVELOCK_SCHEDULER_ENABLED=true
ENVELOCK_ESCALATION_CYCLE_SECONDS=60
ENVELOCK_RETENTION_PURGE_SECONDS=3600
ENVELOCK_WEBHOOK_DELIVERY_SECONDS=30
# How often the monthly-digest job WAKES UP, not how often a customer gets one —
# the due date lives on the tenant row. Six-hourly. The digest is the only thing
# that tells a customer on a quiet month what they are paying for; it needs a
# working SMTP relay and sends nothing when a month contained no alerts.
ENVELOCK_DIGEST_CYCLE_SECONDS=21600

# ─── Observability ──────────────────────────────────────────────────────────────
# LOG_JSON forces structured logs (auto-detects otherwise). METRICS_TOKEN
# bearer-protects GET /metrics from non-local scrapers.
# Unset = auto-detect by TTY; uncomment to force structured JSON logs.
# ENVELOCK_LOG_JSON=true
ENVELOCK_METRICS_TOKEN=

# ─── Platform operators ─────────────────────────────────────────────────────────
# Break-glass allowlist for the cross-tenant admin console — YOUR real
# operator account only, never grantable in-app. Day-to-day operators are
# staff_accounts with department permissions (needs FOCUS_CORE=false).
ENVELOCK_SUPERADMIN_EMAILS=

# ─── Dangerous one-time flags ───────────────────────────────────────────────────
# RESET_SCHEMA_ON_STARTUP drops the schema and ERASES ALL DATA on every boot.
# Repair tool for a drifted dev database only; production refuses to start
# with it set.
ENVELOCK_RESET_SCHEMA_ON_STARTUP=false
