# /etc/systemd/system/envelock-worker.service
#
# Only needed once credential key custody is split (deploy/README.md). This is
# the ONLY process that should hold ENVELOCK_CREDENTIAL_PRIVATE_KEY: it decrypts
# mailbox credentials in order to connect to mail servers, which is exactly what
# the internet-facing API must not be able to do.
#
# Give it its own env file with both key halves, and give the API's env file the
# public key only.
[Unit]
Description=Envelock mailbox worker (credential-holding)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# Restart for ever: a worker that gives up after a 30-second Postgres restart is
# mail analysis stopped until someone notices. (StartLimitIntervalSec=60 used to
# sit in [Service], where systemd ignores it — this was already the behaviour.)
StartLimitIntervalSec=0

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/server
EnvironmentFile=/home/ubuntu/apps/server/.env.worker
# The worker runs the pollers and the scheduler; it serves no HTTP, so it binds
# a loopback port nothing routes to and is never reachable from outside.
ExecStart=/home/ubuntu/apps/server/.venv/bin/uvicorn envelock.main:app \
    --host 127.0.0.1 --port 8011

Restart=always
RestartSec=5

# This process parses attacker-controlled attachments (PDF, DOCX, images). If
# one blows up its memory, it is the one the kernel kills — systemd restarts it
# in seconds — rather than Postgres. The ceiling is half the machine.
MemoryMax=50%
OOMScoreAdjust=500

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Read-only: the worker writes nothing to disk except /tmp (private, above).

[Install]
WantedBy=multi-user.target
