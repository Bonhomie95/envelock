# Envelock web client — build-time configuration (Vite).
#
#   cp .env.example .env.production      # for local production builds
#   …or set these in the Vercel dashboard (Project → Settings → Environment
#     Variables) so the deployed build picks them up.
#
# Note: .env / .env.* are gitignored (only this .env.example is committed), so a
# committed file will NOT reach Vercel — use the Vercel dashboard for the deploy.

# Base URL of the Envelock API. The client calls this directly; a relative
# "/api/..." would hit the static host itself (the "calling itself → 500 /
# CORS" failure). There is NO baked-in default: an unset value means same-origin
# (fine for the dev proxy, wrong for app.envelock.org, whose nginx serves static
# files only) — so production builds MUST set this.
VITE_API_BASE_URL=https://api.envelock.org

# Store listings for the Envelock sensor browser extension. Leave unset until
# the listing is live: the dashboard shows a store button only when its URL is
# set, and otherwise says plainly that the extension is in review (it never
# links a placeholder). Thunderbird and Outlook need nothing here — they install
# from files this app serves itself.
# VITE_SENSOR_CHROME_URL=https://chromewebstore.google.com/detail/...
# VITE_SENSOR_EDGE_URL=https://microsoftedge.microsoft.com/addons/detail/...
# VITE_SENSOR_FIREFOX_URL=https://addons.mozilla.org/firefox/addon/...
