*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Built from sensor/ by `npm run build:sensor`, which `npm run build` runs first.
# Generated on every build, so never committed — a stale copy would ship an old
# sensor with a new dashboard.
public/addins/
public/downloads/
sensor/dist/
