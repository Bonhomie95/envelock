{
  "manifest_version": 2,
  "name": "Envelock Sensor",
  "version": "1.0.0",
  "description": "Tells Envelock which messages you open in Thunderbird, so it can warn you when someone else reads your mail.",
  "author": "Envelock",
  "homepage_url": "https://envelock.org",
  "browser_specific_settings": {
    "gecko": {
      "id": "sensor-thunderbird@envelock.org",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "envelock-sensor.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Envelock",
    "default_icon": "icons/icon-32.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage",
    "alarms",
    "notifications",
    "https://api.envelock.org/*"
  ],
  "optional_permissions": [
    "https://*/*"
  ],
  "message_display_action": {
    "default_title": "Envelock",
    "default_icon": "icons/icon-32.png"
  }
}
