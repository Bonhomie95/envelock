<?xml version="1.0" encoding="UTF-8"?>
<!--
  Envelock Sensor — Outlook add-in manifest.

  Install: Microsoft 365 admin centre → Integrated apps → Upload custom apps →
  "Provide link to manifest file" → https://app.envelock.org/addins/outlook/manifest.xml
  (or, for one person: Outlook → Get Add-ins → My add-ins → Add a custom add-in → From URL).

  The Id below is permanent. Changing it makes Outlook treat this as a different
  add-in, and every existing install stops receiving updates.

  Office add-ins run for Exchange, Microsoft 365 and Outlook.com mailboxes. A
  plain IMAP account added to classic Outlook does not load add-ins at all —
  those customers use the Thunderbird add-on or the browser extension instead.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>ebfe3fa5-992f-4328-ac78-2867f0ad6f22</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Envelock</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Envelock Sensor"/>
  <Description DefaultValue="Tells Envelock which messages you open in Outlook, so it can warn you when someone else reads your mail."/>
  <IconUrl DefaultValue="https://app.envelock.org/addins/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://app.envelock.org/addins/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://app.envelock.org/docs#sensor"/>
  <AppDomains>
    <AppDomain>https://app.envelock.org</AppDomain>
    <AppDomain>https://api.envelock.org</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://app.envelock.org/addins/outlook/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- ReadItem: the internetMessageId of the open message and the signed-in
       address. The add-in never reads a message body. -->
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!-- Pinning is a v1.1 capability, so the real definition lives in the
         nested v1.1 block; the v1.0 wrapper is what older clients parse. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="envelockGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="envelockOpenPane">
                    <Label resid="buttonLabel"/>
                    <Supertip>
                      <Title resid="buttonLabel"/>
                      <Description resid="buttonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                      <!-- Pinned, the pane stays open from message to message,
                           which is what lets it attest every read. -->
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://app.envelock.org/addins/outlook/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://app.envelock.org/addins/outlook/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://app.envelock.org/addins/outlook/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="taskpaneUrl" DefaultValue="https://app.envelock.org/addins/outlook/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="Envelock"/>
          <bt:String id="buttonLabel" DefaultValue="Envelock sensor"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="buttonTip" DefaultValue="Open and pin the Envelock sensor so Envelock can tell your reads from anyone else's."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
